# PostgreSQL connection string.
#
#   npm run db:pg    starts a real PostgreSQL 18 on this address with nothing
#                    to install (see scripts/pg-dev.mjs)
#
# Point it at any server for real deployments — a local install, Supabase,
# RDS, Neon — the SQL is identical either way.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/isp?schema=public"

# Secret used to sign the session cookie. Generate a fresh one for production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="change-me"

# Shared secret for the scheduled endpoint (POST /api/cron). Without it that
# route refuses every request.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=""
