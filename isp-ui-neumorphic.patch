+/* ==========================================================================
+   Neumorphic (soft-UI) primitives
+   ========================================================================== */
+
+/** Raised soft surface — the default card look. */
+@utility neu {
+  background: var(--neu-bg);
+  border: none;
+  box-shadow:
+    7px 7px 16px var(--neu-dark),
+    -7px -7px 16px var(--neu-light);
+}
+
+/** Smaller raised surface — buttons, pills, chips. */
+@utility neu-sm {
+  background: var(--neu-bg);
+  border: none;
+  box-shadow:
+    4px 4px 10px var(--neu-dark),
+    -4px -4px 10px var(--neu-light);
+}
+
+/** Pressed-in surface — search fields, toggles-off, sliders. */
+@utility neu-inset {
+  background: var(--neu-bg);
+  border: none;
+  box-shadow:
+    inset 4px 4px 10px var(--neu-dark),
+    inset -4px -4px 10px var(--neu-light);
+}
+
+/** Tactile press: extruded -> inset on :active. Pair with neu / neu-sm. */
+@utility neu-press {
+  transition:
+    box-shadow 0.15s ease-out,
+    transform 0.15s ease-out;
+  &:active {
+    box-shadow:
+      inset 4px 4px 10px var(--neu-dark),
+      inset -4px -4px 10px var(--neu-light);
+    transform: scale(0.98);
+  }
+}
+
+/** Brand gradient (blue -> purple) for primary actions / active states. */
+@utility neu-gradient {
+  background: linear-gradient(135deg, var(--neu-accent-from), var(--neu-accent-to));
+}
+
+/** Staggered rise-in for card grids (apply to the grid parent). */
+.stagger-rise > * {
+  animation: isp-fade-in 0.32s ease-out both;
+}
+.stagger-rise > *:nth-child(2) {
+  animation-delay: 0.06s;
+}
+.stagger-rise > *:nth-child(3) {
+  animation-delay: 0.12s;
+}
+.stagger-rise > *:nth-child(4) {
+  animation-delay: 0.18s;
+}
+.stagger-rise > *:nth-child(5) {
+  animation-delay: 0.24s;
+}
+.stagger-rise > *:nth-child(6) {
+  animation-delay: 0.3s;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .stagger-rise > *,
+  .animate-in-up,
+  .animate-slide-in {
+    animation: none !important;
+  }
+  .neu-press {
+    transition: none;
+  }
+}
+
 @utility focus-ring {
   outline: none;
   box-shadow:
@@ -199,4 +291,11 @@ body {
