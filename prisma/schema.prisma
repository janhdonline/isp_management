// ISP Management System - Database Schema
// Provider: sqlite (swap to postgresql/mysql in prisma.config.ts + schema)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Connection strings are supplied per environment; see prisma.config.ts and
  // src/lib/db.ts (Prisma 7 moved URLs out of the schema).
}

// ---------------------------------------------------------------------------
// Enums (SQLite does not support native enums -> stored as String, validated
// in src/lib/enums.ts)
// ---------------------------------------------------------------------------

// User / Role / Permission

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  status       String   @default("Active")
  roleId       String?
  role         Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  lastLoginAt  DateTime?
  /// Bumped on a password change or session revoke. The session cookie carries
  /// this value, so a cookie signed before the bump stops verifying — which is
  /// how a stateless JWT session is ended early.
  tokenVersion Int      @default(0)
  /// The TOTP shared secret, AES-256-GCM encrypted. Write-only: nothing in this
  /// application ever sends it back to a browser, and the plaintext is shown once at
  /// enrollment so it can be typed into an authenticator by hand.
  totpSecretEnc String?
  /// Whether a valid code is *required* at sign-in.
  ///
  /// Separate from `totpSecretEnc` being present, so that an administrator can
  /// revoke a user's second factor by clearing one flag without destroying an
  /// enrollment the user may be about to re-confirm. And separate from
  /// `security.require2fa`, which is a role-level policy: this column is the
  /// user's own decision, and it is what makes the answer to "can this person log
  /// in with a password alone" a fact about them rather than a setting.
  totpEnabled   Boolean   @default(false)
  totpEnabledAt DateTime?
  /// Single-use recovery codes, **hashed**. Never stored in plaintext, for the
  /// same reason passwords are not: this column is read by anyone who can read the
  /// user table, and a plaintext recovery code is a password.
  backupCodesEnc  String?
  backupCodesUsedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  activityLogs ActivityLog[]     @relation("LogActor")
  payments     Payment[]         @relation("PaymentCollector")
  shiftsHeld   CashShift[]       @relation("ShiftHolder")
  shiftsClosed CashShift[]       @relation("ShiftCloser")
  branchId     String?
  branch       Branch?           @relation("StaffBranch", fields: [branchId], references: [id], onDelete: SetNull)
  invoices     Invoice[]         @relation("InvoiceCreator")
  expenses     Expense[]         @relation("ExpenseCreator")
  customers    Customer[]        @relation("CustomerCreatedBy")
  tickets      Ticket[]          @relation("TicketCreator")
  messages     Notification[]    @relation("MessageSender")
  walletEntries WalletTransaction[]
  resets       PasswordReset[]
  mandatesCreated PaymentMandate[] @relation("MandateCreator")
  backups      Backup[]
  stockMovements StockMovement[] @relation("StockMovementBy")

  @@index([roleId])
  @@index([status])
}

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  isSystem    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id       String @id @default(cuid())
  key      String @unique // e.g. "customers.create"
  resource String // e.g. "Customers"
  action   String // e.g. "Create"
  label    String
  roles    RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model ActivityLog {
  id         String   @id @default(cuid())
  action     String
  entity     String
  entityId   String?
  summary    String
  meta       String? // JSON
  ipAddress  String?
  userAgent  String?
  actorId    String?
  actor      User?    @relation("LogActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Geography

model Zone {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  areas       Area[]

  @@index([status])
}

model Area {
  id        String   @id @default(cuid())
  name      String
  code      String?  @unique
  zoneId    String?
  zone      Zone?    @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  status    String   @default("Active")
  /// Centroid of the area, used as the map pin and as the fallback pin for a
  /// fiber incident when the OLT's own position is unknown.
  latitude  Float?
  longitude Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customers Customer[]
  routers   Router[]
  ipPools   IpPool[]
  olts      Olt[]
  onus      Onu[]
  fiberRoutes FiberRoute[]
  employees Employee[]
  resellers Reseller[]
  tickets   Ticket[]

  @@unique([name, zoneId])
  @@index([zoneId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Package

model Package {
  id              String   @id @default(cuid())
  name            String   @unique
  downloadSpeed   Int // Mbps
  uploadSpeed     Int // Mbps
  monthlyPrice    Float
  installationFee Float    @default(0)
  validityDays    Int      @default(30)
  billingCycle    String   @default("Monthly")
  fupLimit        Float? // GB
  description     String?
  status          String   @default("Active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customers         Customer[]
  invoices          Invoice[]
  changeLogs        CustomerPackageChange[]
  toPackageChanges  CustomerPackageChange[] @relation("ToPackage")
  tickets           Ticket[]
  expenses          Expense[]
  /// The RouterOS rate-limit profile this package maps to, e.g. "10Mbps".
  /// Null means subscribers on this package are provisioned with no profile,
  /// which is the same as leaving the router default in place.
  mikrotikProfile String?
  /// The profile applied when a subscriber on this package crosses their FUP
  /// limit. Null means there is nothing to throttle them to, so crossing the
  /// limit can only produce a notification.
  fupProfile String?

  @@index([status])
}

// ---------------------------------------------------------------------------
// Customer + Connection

model Customer {
  id                String    @id @default(cuid())
  customerCode      String    @unique
  name              String
  fatherName        String?
  motherName        String?
  phone             String
  altPhone          String?
  email             String?
  nid               String?
  branchId          String?
  branch            Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  dateOfBirth       DateTime?
  gender            String?
  address           String?
  areaId            String?
  area              Area?     @relation(fields: [areaId], references: [id], onDelete: SetNull)
  customerType      String    @default("Home")

  // Corporate and dedicated clients (ISP.md §33).
  //
  // Nullable rather than defaulted, so a Home customer has null here rather than
  // empty strings — "this is a home account with no company" is not the same
  // statement as "this is a home account", and only the second is ever asked.
  //
  // `cirMbps` is the committed information rate: what the contract guarantees.
  // `mirMbps` the maximum: what the pipe could physically do. The gap between
  // them is the whole commercial point of a CIR contract, and a report showing
  // only one of them cannot answer "is this client served as sold".
  companyName      String?
  contactPerson    String?
  contactPhone     String?
  /// Recorded here; the KYC checklist (Phase V) is what enforces it, not this field.
  tradeLicenseNo   String?
  cirMbps          Float?
  mirMbps          Float?
  /// Response-time commitment in hours, defaulted from Settings when the client is
  /// created. Tickets opened against this customer get `slaDueAt` from it.
  slaHours         Int?
  /// What the invoice says it is for, when the bill is for the company rather than
  /// the person who pays it.
  billingLabel     String?

  photoUrl          String?

  // Connection information
  username          String    @unique
  /// The PPPoE secret as the router stores it. It is a network credential, not a
  /// login: it is sent to the MikroTik in the clear, so it must never be
  /// accepted as proof of identity anywhere.
  password          String?
  /// bcrypt hash of the *portal* password — a separate credential the customer
  /// chose, for this site only. Null means portal access has not been set up.
  portalPasswordHash String?
  /// Bumped when the portal password changes, which ends every portal session
  /// issued before it. A JWT cannot be edited to claim a newer version.
  portalTokenVersion Int      @default(0)
  connectionType    String    @default("PPPoE")
  packageId         String?
  package           Package?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  ipType            String    @default("Dynamic")
  ipAddress         String?
  macAddress        String?
  routerId          String?
  router            Router?   @relation(fields: [routerId], references: [id], onDelete: SetNull)
  oltId             String?
  olt               Olt?      @relation(fields: [oltId], references: [id], onDelete: SetNull)
  onuId             String?
  onu               Onu?      @relation(fields: [onuId], references: [id], onDelete: SetNull)
  ponPort           String?

  // Dates
  connectionDate    DateTime  @default(now())
  billingDate       DateTime?
  expiryDate        DateTime?

  // Billing snapshot
  monthlyBill       Float     @default(0)
  installationFee   Float     @default(0)
  advancePayment    Float     @default(0)
  previousDue       Float     @default(0)
  /// True while the customer is on the throttled profile because they have used
  /// up the package's FUP allowance. Sticky within a cycle, so the throttle is
  /// applied once rather than on every scheduled run.
  fupThrottled      Boolean   @default(false)
  fupThrottledAt    DateTime?
  discount          Float     @default(0)
  vat               Float     @default(0)
  totalPayable      Float     @default(0)

  // Status (connection status - see ISP.md section 15)
  connectionStatus  String    @default("Active") // Active | Suspended | Disconnected | Pending
  billingStatus     String    @default("Unpaid") // Unpaid | Paid | Partial | Due
  onlineStatus      String    @default("Offline") // Online | Offline
  suspendReason     String?
  suspendedAt       DateTime?
  disconnectReason  String?
  disconnectedAt    DateTime?
  lastOnlineAt      DateTime?
  loginTime         DateTime?
  downloadBytes     BigInt    @default(0)
  uploadBytes       BigInt    @default(0)

  note              String?
  createdById       String?
  createdBy         User?     @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  invoices     Invoice[]
  payments     Payment[]
  walletTransactions WalletTransaction[]
  dailyUsage         DailyUsage[]
  ipAllocation       IpAllocation?
  tickets      Ticket[]
  sessionLogs  OnlineSession[]
  packageLogs  CustomerPackageChange[]
  notifications Notification[]
  expenses     Expense[]
  mandates     PaymentMandate[]
  autoCollections AutoCollectionRun[]
  networkActions NetworkAction[]
  equipment    CustomerEquipment[]
  resellerId   String?
  reseller     Reseller? @relation(fields: [resellerId], references: [id], onDelete: SetNull)

  @@index([areaId])
  @@index([packageId])
  @@index([connectionStatus])
  @@index([billingStatus])
  @@index([onlineStatus])
  @@index([expiryDate])
  @@index([phone])
}

model CustomerPackageChange {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fromPkgId  String?
  fromPkg    Package? @relation(fields: [fromPkgId], references: [id], onDelete: SetNull)
  toPkgId    String?
  toPkg      Package? @relation("ToPackage", fields: [toPkgId], references: [id], onDelete: SetNull)
  reason     String?
  changedById String?
  createdAt  DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Billing

model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  packageId     String?
  package       Package?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  issueDate     DateTime  @default(now())
  dueDate       DateTime
  billingFrom   DateTime?
  billingTo     DateTime?
  amount        Float
  discount      Float     @default(0)
  vat           Float     @default(0)
  total         Float
  paid          Float     @default(0)
  status        String    @default("Due") // Paid | Partial | Due | Overdue | Cancelled
  note          String?
  createdById   String?
  createdBy     User?     @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  payments  Payment[]
  receipts  Receipt[]
  walletTransactions WalletTransaction[]
  autoCollections AutoCollectionRun[]

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@index([issueDate])
}

model Payment {
  id            String   @id @default(cuid())
  paymentId     String   @unique // human readable e.g. PAY-000123
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceId     String?
  invoice       Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  amount        Float
  discount      Float    @default(0)
  method        String // Cash | bKash | Nagad | Bank | Card | Online
  transactionId String?
  /// Which aggregator settled this, when it came in through one.
  gatewayProvider String?
  /// The gateway's own transaction id. Unique, and the idempotency key for the
  /// callback: a provider that delivers the same notification twice must not
  /// produce two payments.
  gatewayTxnId  String?   @unique
  gatewayStatus String?
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  collectedById String?
  collectedBy   User?    @relation("PaymentCollector", fields: [collectedById], references: [id], onDelete: SetNull)
  /// Set when a zone reseller took the cash rather than staff. Commission is
  /// derived from this, never stored.
  collectedByResellerId String?
  collectedByReseller   Reseller? @relation("PaymentReseller", fields: [collectedByResellerId], references: [id], onDelete: SetNull)
  paymentDate   DateTime @default(now())
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  receipt  Receipt?
  ledger   AccountTransaction[]
  /// Wallet rows this payment funded, or that it topped up from an excess payment.
  walletTransactions WalletTransaction[]

  @@index([customerId])
  @@index([invoiceId])
  @@index([accountId])
  @@index([method])
  @@index([paymentDate])
  @@index([gatewayTxnId])
}

model Receipt {
  id            String   @id @default(cuid())
  receiptNumber String   @unique
  paymentId     String   @unique
  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId     String?
  invoice       Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  amount        Float
  method        String
  status        String   @default("Paid") // Paid | Refunded
  issuedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Accounts & Expenses

model Account {
  id             String   @id @default(cuid())
  name           String   @unique
  type           String // Cash | Bank | bKash | Nagad | Card | Other
  openingBalance Float    @default(0)
  currentBalance Float    @default(0)
  accountNumber  String?
  bankName       String?
  status         String   @default("Active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  payments    Payment[]
  expenses    Expense[]
  transactions AccountTransaction[]
  transfersFrom AccountTransfer[] @relation("TransferFrom")
  transfersTo   AccountTransfer[] @relation("TransferTo")
  shifts        CashShift[]
  branchId      String?
  branch        Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([status])
}

model AccountTransaction {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type        String // Payment | Expense | Transfer | Refund | Adjustment
  direction   String // Credit | Debit
  amount      Float
  description String?
  reference   String?
  paymentId   String?
  payment     Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  expenseId   String?
  transferId  String?
  userId      String?
  balance     Float
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([accountId])
  @@index([date])
  @@index([type])
}

model AccountTransfer {
  id            String   @id @default(cuid())
  reference     String   @unique
  fromAccountId String
  fromAccount   Account  @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccountId   String
  toAccount     Account  @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  amount        Float
  transferDate  DateTime @default(now())
  note          String?
  createdAt     DateTime @default(now())
}

model Expense {
  id        String   @id @default(cuid())
  category  String
  amount    Float
  date      DateTime @default(now())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  packageId String?
  package   Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  areaId    String?
  customerId String?
  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vendor    String?
  reference String?
  description String?
  attachmentUrl String?
  note      String?
  createdById String?
  createdBy User?    @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([date])
  @@index([accountId])
}

// ---------------------------------------------------------------------------
// Network (MikroTik / OLT / ONU) - behind service adapters
// ---------------------------------------------------------------------------

model Router {
  id          String    @id @default(cuid())
  name        String    @unique
  model       String?
  ipAddress   String
  location    String?
  areaId      String?
  area        Area?     @relation(fields: [areaId], references: [id], onDelete: SetNull)
  apiPort     Int       @default(8728)
  apiUser     String?
  apiSecretEnc String?
  useSsl      Boolean   @default(false)
  /// Where subscribers are terminated: "ppp" (PPPoE) or "hotspot".
  sessionSource String  @default("ppp")
  /// Where on the ground the cabinet is. Optional: a router with no coordinates
  /// is simply absent from the fiber map rather than pinned at (0, 0), which is
  /// the Gulf of Guinea and looks like a bug on every world view.
  latitude  Float?
  longitude Float?
  /// Whether this app may create, reprofile and delete PPP secrets here.
  ///
  /// Off by default, and it must stay that way. Writing to a router is not a
  /// side effect of using a billing system — an admin has to decide which of
  /// their routers this system is allowed to touch, one at a time. Suspension
  /// (Phase A) is not gated by this, because a customer the office has decided
  /// to cut off should be cut off regardless.
  autoProvision Boolean @default(false)
  ipPools       IpPool[]
  /// Whether this router authenticates subscribers against this app's RADIUS
  /// server rather than against PPP secrets on the router itself.
  ///
  /// Off by default, like `autoProvision`, and for the same reason: a router must
  /// be moved onto RADIUS deliberately, one at a time, because the switch changes
  /// where an ISP's entire authentication lives. With it off, everything behaves
  /// exactly as before — the RouterOS API path is untouched and remains the
  /// fallback for routers not yet converted.
  ///
  /// Once on, the router has no subscriber secrets to disable: a suspension is
  /// enforced by this app answering the next Access-Request with Access-Reject,
  /// and by a Disconnect-Request dropping the live session. That is a stronger
  /// guarantee than a disabled secret, which only takes effect at next login.
  useRadius   Boolean   @default(false)
  /// Whether this system programs a **bandwidth** queue per subscriber on this
  /// router, from each package's `downloadSpeed` / `uploadSpeed`.
  ///
  /// Separate from `autoProvision` and `useRadius` because it answers a different
  /// question, and a router can answer all three differently:
  ///
  ///  - `autoProvision` — may this system write PPP secrets here?
  ///  - `useRadius` — does authentication live on the router or in RADIUS?
  ///  - `autoQueues` — may this system shape the *bandwidth* here?
  ///
  /// Off by default, like the other two. A queue with the wrong limits throttles a
  /// paying customer to a speed they did not buy, and there is no way for the
  /// customer to tell that from the network being slow — so it has to be a
  /// decision somebody makes about one router at a time.
  ///
  /// When `useRadius` is also on, RADIUS wins and this is ignored: the
  /// Mikrotik-Rate-Limit attribute is already carrying the same number, and two
  /// limiters on one subscriber means whichever is stricter wins, which is not
  /// something an operator chose.
  autoQueues  Boolean   @default(false)
  status      String    @default("Unknown") // Online | Offline | Unknown
  cpu         Float?
  ram         Float?
  uptimeSec   Int?
  activeUsers Int       @default(0)
  lastSyncAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customers Customer[]

  @@index([status])
  @@index([areaId])
}

model Olt {
  id         String   @id @default(cuid())
  name       String   @unique
  vendor     String?
  model      String?
  ipAddress  String?
  location   String?
  areaId     String?
  area       Area?    @relation(fields: [areaId], references: [id], onDelete: SetNull)
  ponPorts   Int      @default(0)
  /// How many ONUs one PON port carries on this cabinet — 64 on a GPON split, 32
  /// on some older or configured-down equipment.
  ///
  /// Null means "use the network default" (`pon.defaultSplitRatio`), which is the
  /// right answer for most cabinets and the wrong one for an OLT that has been
  /// reconfigured to 32. Deliberately a number on the row rather than a setting
  /// key per OLT: it is a property of the hardware, it is queried when usage is
  /// derived, and an operator changing it needs to see it on the cabinet.
  splitRatio Int?
  status     String   @default("Unknown") // Online | Offline | Unknown
  /// Which adapter speaks to this OLT: `snmp-huawei`, `snmp-bdcom`,
  /// `snmp-vsol`. Null means nobody polls this cabinet, which is different from
  /// polling it and finding it unreachable — one is a choice, the other is a fault.
  apiVendor  String?
  /// **Whether** an SNMP community is configured for this OLT, never the community
  /// itself — the same write-only shape as `Router.apiSecretEnc`. The value lives
  /// in an `isSecret` Settings row, so no select on this model can put it in a log,
  /// an export or a response.
  snmpCommunityEnc Boolean @default(false)
  snmpPort   Int      @default(161)
  /// Why the last poll failed. An OLT we could not reach is recorded as `Unknown`,
  /// never `Offline`: the difference is "we have not heard from it" and "it said
  /// it is down", and only one of those is worth paging anybody for. Its ONUs are
  /// left exactly as they were.
  lastError  String?
  lastSyncAt DateTime?
  /// Where the OLT cabinet stands. Used as the map pin for a fiber incident when
  /// nothing more precise is known, so a technician is sent to the site rather
  /// than to (0, 0).
  latitude   Float?
  longitude  Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  onus      Onu[]
  customers Customer[]
  /// Fiber runs leaving this OLT, drawn on the map as the actual route rather
  /// than a straight line between two markers.
  fiberRoutes FiberRoute[]
  /// Serials this OLT is serving that we have no customer for.
  rogueOnus   RogueOnu[]

  @@index([status])
}

/// A serial the OLT is serving that is not in our database.
///
/// Someone has plugged in their own equipment. That is a billing and security
/// question before it is a technical one, so it is recorded rather than ignored:
/// an unregistered ONU is somebody's traffic nobody is paying for.
///
/// The `@@unique` on `(oltId, serialNo)` is the claim, not just a guard. A sync
/// runs from three schedulers in this deployment and an operator will also press
/// the button by hand, so "have we seen this serial" is a check two of them can
/// both pass. `dedupeKey` is a second claim, held only while the rogue is
/// unresolved, so an alert goes out once per incident and again if a cleaned-up
/// serial reappears.
model RogueOnu {
  id        String   @id @default(cuid())
  oltId     String
  olt       Olt      @relation(fields: [oltId], references: [id], onDelete: Cascade)
  serialNo  String
  ponIndex  String?
  rxPower   Float?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  /// Set when somebody removed it from the OLT. A resolved row is history; an
  /// unresolved one is a problem.
  resolvedAt DateTime?
  /// `rogue:{oltId}:{serialNo}`, held only while unresolved. Nulled on resolve for
  /// the reason `DeviceAlert.dedupeKey` is: leaving it would make the index reject
  /// the next sighting of a serial that was cleaned up and came back.
  dedupeKey String?  @unique
  /// Whether anyone was told. A rogue ONU nobody heard about is a different thing
  /// from one they were.
  notifiedAt DateTime?

  @@unique([oltId, serialNo])
  @@index([resolvedAt])
  @@index([serialNo])
}

/// One fiber run, as the crew walked it.
///
/// `points` is an ordered `[{ lat, lng }, ...]`, drawn as a polyline. It is a
/// `Json` array rather than a child table because it is only ever read and
/// written whole: there is nothing to query *inside* a route, and a separate row
/// per waypoint would make editing a route two dozen writes to keep in order.
model FiberRoute {
  id    String @id @default(cuid())
  name  String
  points Json
  /// Optional links: a route is usually one OLT's feeder or one area's laterals,
  /// but a route that serves neither is still worth drawing.
  oltId  String?
  olt    Olt?   @relation(fields: [oltId], references: [id], onDelete: SetNull)
  areaId String?
  area   Area?  @relation(fields: [areaId], references: [id], onDelete: SetNull)
  note   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([oltId])
  @@index([areaId])
}

model Onu {
  id         String   @id @default(cuid())
  serialNo   String   @unique
  name       String?
  vendor     String?
  /// Reported by the device in its Inform, on first contact only. "Huawei" alone
  /// tells an operator nothing; "MA5800" tells them which firmware to look at.
  /// Kept out of the update path for the same reason as every other Inform field.
  model      String?
  oltId      String?
  olt        Olt?     @relation(fields: [oltId], references: [id], onDelete: SetNull)
  areaId     String?
  area       Area?    @relation(fields: [areaId], references: [id], onDelete: SetNull)
  ponIndex   String?
  rxPower    Float? // dBm
  txPower    Float?
  /// Online | Offline | Low Signal | Provisioning | Unknown
  ///
  /// `Provisioning` is not a radio state. It means the device told the ACS it
  /// exists and has not been given a working configuration — a different problem
  /// from an outage, and one that needs a different person to look at it.
  status     String   @default("Offline")
  lastSeenAt DateTime?
  /// The drop point, if the crew has walked out where the ONT actually hangs.
  latitude   Float?
  longitude  Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customers Customer[]
  /// Every TR-069 operation against this device, in the order it happened.
  tr069Logs Tr069Log[]

  @@index([status])
  @@index([oltId])
}

/// One TR-069 operation against one device, and how it went.
///
/// There is deliberately **no payload column** here. A pushed configuration
/// contains the customer's PPPoE password, so the row records a SHA-256 of the
/// payload instead: enough to prove that two pushes were identical, and useless
/// to anybody who reads the table. `detail` is written by our own code, never
/// copied from the device's answer.
model Tr069Log {
  id       String  @id @default(cuid())
  onuId    String?
  onu      Onu?    @relation(fields: [onuId], references: [id], onDelete: SetNull)
  /// Kept even when the ONU row is gone: the serial is the device's own identity,
  /// and is what a support agent reads off the bottom of the box.
  serialNo String
  /// inform | pushConfig | reboot | factoryReset
  action   String
  /// Hex SHA-256 of the payload that was sent, or of the Inform that arrived.
  payloadHash String?
  /// Success | Failure
  result    String
  /// Why it failed, or what the device reported. Never contains a secret.
  detail    String?
  /// The outbox row when this attempt was a retry of a queued push.
  actionId  String?
  createdAt DateTime @default(now())

  @@index([serialNo, createdAt])
  @@index([onuId, createdAt])
  @@index([result, createdAt])
}

model OnlineSession {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  username   String
  ipAddress  String?
  macAddress String?
  routerId   String?
  loginTime  DateTime @default(now())
  logoutTime DateTime?
  downloadBytes BigInt @default(0)
  uploadBytes   BigInt @default(0)

  @@index([customerId])
  @@index([loginTime])
}

// ---------------------------------------------------------------------------
// Support

model Ticket {
  id           String    @id @default(cuid())
  ticketNumber String    @unique
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  areaId       String?
  area         Area?     @relation(fields: [areaId], references: [id], onDelete: SetNull)
  branchId     String?
  branch       Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  packageId    String?
  package      Package?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  subject      String
  problem      String
  description  String?
  category     String    @default("Other")
  priority     String    @default("Medium") // Low | Medium | High | Critical
  /// When a corporate client's contractual response time runs out. Set at creation
  /// from the customer's `slaHours`, and read by the SLA tracker (Phase U). Null
  /// for a home customer, which has no contract and therefore no deadline.
  slaDueAt     DateTime?
  /// True once `slaDueAt` has passed and the ticket is still open.
  ///
  /// Stored rather than derived from `slaDueAt` alone, because "overdue" is a
  /// fact about a moment — a ticket closed after breaching was not escalated, and
  /// recomputing it from the timestamp would call it so for ever after.
  escalated    Boolean   @default(false)
  slaBreached  Boolean   @default(false)
  /// When the escalation job bumped this ticket's priority one level, if ever.
  ///
  /// Null until the first bump and never set again: the point of escalation is
  /// that it happens once. Without this column the job would read `escalated:
  /// true` and have no way to know whether it already raised the priority, so a
  /// second run — or a manual re-run after a deploy — would bump it again, and a
  /// ticket that started at High would end up Critical by accident.
  priorityRaisedAt DateTime?
  status       String    @default("Open") // Open | Pending | In Progress | Resolved | Closed
  technicianId String?
  technician   Employee? @relation(fields: [technicianId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?     @relation("TicketCreator", fields: [createdById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?
  closedAt     DateTime?
  /// Set only on a ticket that stands for many customers at once — currently
  /// just the fiber-fault ticket (ISP.md §35). Unique, because two concurrent
  /// runs of the fault job both deciding they are first to notice the same outage
  /// is a race the database has to lose one of; a check-then-insert is two
  /// queries and both of them can pass the check. Null on an ordinary ticket,
  /// which is not deduplicated and several of them are legitimate.
  dedupeKey    String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  comments TicketComment[]

  @@index([status])
  @@index([priority])
  @@index([technicianId])
  @@index([escalated])
  @@index([slaDueAt])
  @@index([slaBreached])
}

model TicketComment {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorName String
  body      String
  isInternal Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([ticketId])
}

model Employee {
  id          String    @id @default(cuid())
  employeeCode String    @unique
  name        String
  role        String
  phone       String
  email       String?
  areaId      String?
  area        Area?     @relation(fields: [areaId], references: [id], onDelete: SetNull)
  joiningDate DateTime  @default(now())
  status      String    @default("Active")
  photoUrl    String?
  address     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tickets      Ticket[]
  attendances  Attendance[]
  leaves       Leave[]
  salaries     Salary[]

  @@index([status])
}

model Attendance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status     String   @default("Present") // Present | Absent | Late | Leave
  note       String?
  createdAt  DateTime @default(now())

  @@unique([employeeId, date])
  @@index([date])
}

model Leave {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType  String
  startDate  DateTime
  endDate    DateTime
  reason     String?
  status     String   @default("Pending") // Pending | Approved | Rejected
  approvedBy String?
  createdAt  DateTime @default(now())

  @@index([employeeId])
  @@index([status])
}

model Salary {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month      String // YYYY-MM
  basic      Float    @default(0)
  allowance  Float    @default(0)
  bonus      Float    @default(0)
  deduction  Float    @default(0)
  advance    Float    @default(0)
  netSalary  Float    @default(0)
  status     String   @default("Pending") // Paid | Pending
  paidAt     DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, month])
}

// ---------------------------------------------------------------------------
// Notifications & System

model Notification {
  id     String @id @default(cuid())
  channel String // SMS | Email | WhatsApp
  recipient String
  customerId String?
  customer  Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  template  String?
  subject   String?
  body      String
  status    String @default("Sent") // Sent | Failed | Pending | Scheduled
  error     String?
  /// Set only on reminders, to the key that makes sending one exactly-once:
  /// `reminder:{customerId}:{invoiceId}:{kind}:{dayOffset}` (ISP.md §29).
  ///
  /// The uniqueness is what enforces it. A scheduled job is fired by three
  /// different schedulers in this deployment, and two of them firing in the same
  /// second is not a bug to guard against in application code but a race the
  /// database has to lose one of — a "check then insert" is two queries and two
  /// of them can pass the check. Null on ordinary manual messages, because those
  /// are not deduplicated and several of them are legitimate.
  idempotencyKey String? @unique
  /// What happened on the way out, for the reminder path: which channels were
  /// tried and why it fell through to the one that worked. `error` is only
  /// meaningful on a failure, so a successful fallback has nowhere else to say
  /// that it was one.
  notes     String?
  sentById    String?
  sentBy      User?     @relation("MessageSender", fields: [sentById], references: [id], onDelete: SetNull)
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([channel])
  @@index([status])
  @@index([createdAt])
}

model SmsCredit {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  sent      Int      @default(0)
  failed    Int      @default(0)
  balance   Int      @default(0)
  createdAt DateTime @default(now())
}

model Setting {
  key       String   @id
  value     String
  group     String   @default("General")
  isSecret  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model Backup {
  id         String   @id @default(cuid())
  fileName   String
  size       Int
  type       String   @default("Manual") // Manual | Auto
  status     String   @default("Completed")
  createdById String?
  createdBy  User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model Counter {
  id    String @id
  value Int    @default(0)
}

/// A till held by one member of staff over a period of time: the float they
/// started with, the cash physically counted at close, and the difference.
model CashShift {
  id           String   @id @default(cuid())
  shiftNumber  String   @unique
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation("ShiftHolder", fields: [userId], references: [id], onDelete: Cascade)
  openingFloat Float    @default(0)
  countedCash  Float?
  expectedCash Float?
  /// Counted minus expected, recorded rather than corrected away: a till that
  /// silently adjusts itself teaches nobody anything.
  variance     Float?
  status       String   @default("Open") // Open | Closed
  note         String?
  openedAt     DateTime @default(now())
  closedAt     DateTime?
  closedById   String?
  closedBy     User?    @relation("ShiftCloser", fields: [closedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([accountId, status])
  @@index([openedAt])
}

/// An office or cost centre inside one company. Not a tenant boundary: this is
/// for attributing money and staff to a location, not for separating data
/// between separate businesses.
model Branch {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  city         String?
  address      String?
  phone        String?
  managerName  String?
  isDefault    Boolean  @default(false)
  status       String   @default("Active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts  Account[]
  areas     Area[]
  customers Customer[]
  staff     User[]     @relation("StaffBranch")
  tickets   Ticket[]

  @@index([status])
}

/// A standing instruction to take payment without asking each time. A card or
/// account number is not stored here — only the gateway's own token for it.
model PaymentMandate {
  id           String    @id @default(cuid())
  reference    String    @unique
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  method       String    // Bank Transfer | Mobile Wallet | Card
  accountNumber String?
  mobileNumber String?
  bankName     String?
  /// A ceiling the customer agreed to. A balance above it is left for a human.
  maxAmount    Float?
  status       String    @default("Active") // Active | Paused | Cancelled
  lastAttemptAt DateTime?
  lastSuccessAt DateTime?
  lastFailureReason String?
  successCount Int       @default(0)
  failureCount Int       @default(0)
  createdById  String?
  createdBy    User?     @relation("MandateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([customerId])
}

/// One row per automatic collection attempt, kept whether it succeeded or not.
/// An attempt that was charged but not recorded has to be findable, or the
/// customer gets billed twice and nobody knows why.
model AutoCollectionRun {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  invoiceId     String?
  invoice       Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  amount        Float
  method        String
  status        String   @default("Collected") // Collected | Failed | Unrecorded | Skipped
  transactionId String?
  note          String?
  createdAt     DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

/// A command to a router that has not been carried out yet.
///
/// Billing enforcement has to reach the network, and routers fail. Without a
/// queue, "the customer is Suspended in our database but still browsing" is a
/// permanent state, because nobody notices the router call failed. Every
/// enforcement attempt therefore writes a row first, and the router call is the
/// thing that is retried — so the state that is true in the database is always
/// eventually true on the network.
model NetworkAction {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  routerId   String?
  /// The username on the router, kept even if the customer row is gone, so a
  /// pending un-suspend can still be carried out.
  username   String
  /// suspend | reconnect | provision | setProfile | removeQueue
  action     String
  /// Pending | Done | Failed
  status     String    @default("Pending")
  attempts   Int       @default(0)
  lastError  String?
  /// Extra detail: the package profile, the queue limits, whatever the
  /// particular action needed.
  payload    String?
  /// Set when the action is done, so a re-run of the same logical action can be
  /// recognised rather than repeated.
  completedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([customerId])
}

/// A kind of equipment the ISP buys and hands out.
///
/// Stock is not a free-form number someone types in: `quantity` is the running
/// total of `StockMovement` rows, and the two are only ever written together in
/// one transaction. That is what makes the figure trustworthy — a stock level
/// that can be edited directly is a stock level that will be wrong.
model InventoryItem {
  id          String   @id @default(cuid())
  name        String
  sku         String   @unique
  category    String   @default("Other") // ONU | Router | Cable | Splitter | Connector | Other
  unit        String   @default("pcs")
  /// Always the sum of the movements. Recomputed, never trusted.
  quantity    Int      @default(0)
  /// At or below this the item is flagged as low stock.
  reorderLevel Int     @default(0)
  unitPrice   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  movements   StockMovement[]
  assigned    CustomerEquipment[]

  @@index([category])
  @@index([name])
}

/// One line of the stock ledger: what came in, what went out, or what the count
/// actually found. Stock on hand is `SUM(quantity)` over these rows, so the
/// history is the source of truth and cannot drift from the balance.
model StockMovement {
  id        String        @id @default(cuid())
  itemId    String
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type      String // IN | OUT | ADJUST
  /// Signed. IN and ADJUST-up are positive, OUT is negative, ADJUST-down negative.
  quantity  Int
  note      String?
  /// A purchase order number, or the customer the unit went to.
  reference String?
  createdById String?
  createdBy User?       @relation("StockMovementBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())

  @@index([itemId, createdAt])
  @@index([type])
}

/// A specific unit of equipment, in someone's house.
///
/// This is separate from the stock ledger on purpose: a hundred ONUs in the store
/// is a stock figure, and the ONU with serial X in Rahim's flat is a thing that
/// can be traced, returned, or reported faulty. A BTRC audit or a swap-out both
/// need the second kind.
model CustomerEquipment {
  id         String        @id @default(cuid())
  customerId String
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  itemId     String
  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  /// The serial printed on the device. Unique so one unit cannot be in two houses.
  serial     String        @unique
  mac        String?
  status     String        @default("Assigned") // Assigned | Returned | Faulty
  note       String?
  assignedAt DateTime      @default(now())
  returnedAt DateTime?

  @@index([customerId])
  @@index([itemId])
  @@index([status])
}

/// A zone reseller who collects cash on the ISP's behalf.
///
/// Tracked and reported, not a login and not a ledger. Zone-wise collection is
/// how a Bangladeshi ISP actually reaches its customers, and the number that
/// makes it worth doing is the commission, so the report is the product. What is
/// deliberately absent: a separate money ledger and a reseller login. A
/// half-built multi-tenant ledger is worse than none, because the commission
/// report would then have two sources of truth.
model Reseller {
  id            String   @id @default(cuid())
  name          String
  phone         String?
  areaId        String?
  area          Area?    @relation(fields: [areaId], references: [id], onDelete: SetNull)
  /// Percentage of collected cash owed to the reseller.
  commissionPct Decimal  @default(0)
  status        String   @default("Active") // Active | Inactive
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customers Customer[]
  payments  Payment[] @relation("PaymentReseller")

  @@index([status])
}

/* ------------------------------------------------------------------ */
/* RADIUS (ISP.md §28)                                                 */
/* ------------------------------------------------------------------ */

/// One RADIUS session, keyed by the session id the NAS generated.
///
/// Not a log: a row here means traffic was or is being carried, and the octets
/// are what the FUP allowance and the usage report are computed from. It is keyed
/// on `acctSessionId` and not on the username because a subscriber reconnects —
/// a customer who drops their link overnight gets a new session id, and treating
/// that as a continuation would merge two sessions' octets into one figure and
/// understate their usage.
///
/// `seq` is the last Acct-Session-Time seen, and it is what makes Interim-Update
/// idempotent. RADIUS accounting is UDP: a NAS that does not get a response
/// resends, and resending is normal rather than exceptional. Counting the same
/// Interim-Update twice would inflate a customer's traffic, so an update carrying a
/// sequence at or below the stored one is ignored. A `Stop` is a final statement,
/// not a counter, and is applied whatever sequence it carries.
model RadiusAccounting {
  id             String    @id @default(cuid())
  username       String
  /// The NAS's own identifier for the session. Unique, because it is what a
  /// Disconnect-Request has to name.
  acctSessionId  String    @unique
  nasIp          String
  /// What the NAS calls itself, when it says. Informational.
  nasIdentifier  String?
  /// Acct-Status-Type: Start | Interim-Update | Stop
  status         String    @default("Start")
  /// First Acct-Session-Time reported, in seconds. Kept separate from `seq` so
  /// the original figure survives a later update overwriting it.
  startedAt      DateTime  @default(now())
  /// Set by a Stop. Null means the session is live, which is exactly the
  /// predicate `sendDisconnect` looks for.
  stoppedAt      DateTime?
  /// Last Acct-Session-Time seen, in seconds.
  seq            Int       @default(0)
  inputOctets    BigInt    @default(0)
  outputOctets   BigInt    @default(0)
  framedIpAddress String?
  callingStationId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([username])
  /// Serves "which of this customer's sessions are live" on every suspension.
  @@index([stoppedAt])
}

/// A line in the RADIUS Live terminal.
///
/// Bounded on purpose. An unauthenticated RADIUS packet can arrive from the
/// internet, and an ISP-sized access log is millions of rows a month; an
/// unbounded table is a slow disk, not a log. `pruneRadiusLogs` deletes rows past
/// the retention in Settings, and the writer refuses to grow the table past the
/// hard cap even if the job has not run.
model RadiusLog {
  id     Int      @id @default(autoincrement())
  /// accept | reject | accounting | disconnect | dropped
  type   String
  /// Access-Accept | Access-Reject | Start | Interim-Update | Stop | Disconnect-ACK
  outcome String?
  username String?
  nasIp   String?
  /// What to show. Never a secret and never a password: a RADIUS log that
  /// contains either is a credential leak with a UI.
  message String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([type, createdAt])
}

/// The RADIUS process's heartbeat.
///
/// One row, rewritten every 15 seconds. A process that has died stops rewriting
/// it, and the age of the row is the only honest answer to "is the RADIUS server
/// up" — there is no other way to ask a UDP listener that is not currently
/// talking to anyone. A stale row must read as DOWN, not as the last known state.
model RadiusHealth {
  /// Fixed id: there is one RADIUS process per database.
  id         String   @id @default("radius")
  /// Monotonic packets received, so a rate can be derived from two reads.
  packetsIn  Int      @default(0)
  packetsOut Int      @default(0)
  /// When the process last wrote this row. Freshness of this is the health check.
  updatedAt  DateTime @default(now())
  startedAt  DateTime @default(now())
}

/// The customer wallet (ISP.md §30).
///
/// `Customer.advancePayment` is a *cached* balance. This table is the truth: one
/// row per movement, signed, each carrying the balance it produced. The two are
/// written together in one transaction and never in separate queries, so a crash
/// cannot leave a ledger that disagrees with the number the rest of the app reads —
/// and SUM(amount) per customer equals `advancePayment` by construction, which is
/// what `verify` asserts.
///
/// Types, and what each one is allowed to move:
///
///   TopUp           money in, always with a Payment behind it
///   InvoiceConsume  money out, always against an invoice, never more than it
///   RefundOut       money back to the customer, never below zero
///   Adjustment      the only movement without a payment or an invoice, and the
///                   only one that can be typed by hand — which is exactly why it
///                   requires a reason
model WalletTransaction {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// TopUp | Adjustment | InvoiceConsume | RefundOut
  type        String
  /// Signed: positive adds to the wallet, negative takes from it.
  amount      Float
  /// The wallet balance immediately after this row. A running snapshot, so a
  /// single row answers "what was the balance when this happened" without a sum.
  balanceAfter Float
  /// The payment that funded a top-up, the invoice a consumption settled.
  paymentId   String?
  payment     Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  invoiceId   String?
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  /// Free-text reference for a movement with neither: an adjustment, or a refund.
  reference   String?
  /// Mandatory for an Adjustment, and the reason it is the only hand-typed row.
  note        String?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([customerId, createdAt])
  @@index([type])
  @@index([paymentId])
  @@index([invoiceId])
}

/// One customer-day of measured traffic (ISP.md §31).
///
/// An aggregate, not a log: the raw evidence is `OnlineSession` and
/// `RadiusAccounting`, and this is the daily roll-up a chart or a support answer
/// needs. `@@unique([customerId, date])` is what makes the aggregation idempotent —
/// the job upserts on it, so re-running over the same input cannot double-count,
/// and there is no "does today's row exist" check to lose a race against.
///
/// `date` is a `DateTime` pinned to local midnight rather than a `Date`, so a
/// day's boundaries do not shift with the server's timezone between runs.
model DailyUsage {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  date       DateTime @default(now())
  downloadBytes BigInt @default(0)
  uploadBytes   BigInt @default(0)
  /// Minutes actually online that day, union of the day's sessions.
  onlineMinutes Int   @default(0)
  /// Which source produced this row. RADIUS wins when both exist for a day.
  source     String   @default("sessions")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([customerId, date])
  @@index([date])
}

/// An operator-visible incident on a piece of network hardware (ISP.md §32).
///
/// One incident is one row, not a stream of them. A router that is down for six
/// hours produces exactly one open `Down` alert and one `Recovered` notice when it
/// comes back, however many times the monitor ran in between — which is the whole
/// point, because a flapping device that pages somebody twenty times is worse than
/// one that pages once.
///
/// **`dedupeKey` is what enforces that**, not a check-then-insert. It is set for
/// the *open* alert only (`deviceId:Down:Open`) and set to null when that alert is
/// resolved, which frees the key for the next incident while `@unique` collapses
/// every concurrent insert in between. The database settles the race; application
/// code cannot.
model DeviceAlert {
  id         String  @id @default(cuid())
  /// Router | OLT
  deviceType String
  deviceId   String
  deviceName String
  /// Down | Recovered | LowSignal
  kind       String
  /// Open | Resolved
  status     String  @default("Open")
  detail     String?
  /// Set for an open alert, null once resolved. Enforces one open alert per
  /// (device, kind); see above.
  dedupeKey  String? @unique
  /// When the notification went out, and whether it worked. Null means nobody was
  /// reachable — the alert still exists, because a page that failed to send is not
  /// a reason to believe the device is fine.
  notifiedAt  DateTime?
  notifyChannel String?
  notifyError   String?
  openedAt   DateTime @default(now())
  resolvedAt DateTime?

  @@index([status, openedAt])
  @@index([deviceType, deviceId])
  @@index([kind, status])
}

/// A routable subnet an ISP hands addresses out from (ISP.md §34).
///
/// A pool is the unit an operator thinks in — "the 10.10.10.0/24 for the north
/// area" — and expanding it into `IpAllocation` rows is what makes "is that free?"
/// answerable.
model IpPool {
  id     String @id @default(cuid())
  name   String
  /// Canonical CIDR, e.g. "10.10.10.0/24". Validated on write; the pool is not
  /// usable until it parses.
  cidr   String
  /// Excluded from allocation, which is why a /24 yields 253 addresses and not 254.
  gateway String?
  dns     String?
  routerId String?
  router   Router? @relation(fields: [routerId], references: [id], onDelete: SetNull)
  areaId   String?
  area     Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations IpAllocation[]

  @@unique([name])
  @@index([cidr])
}

/// One address inside a pool.
///
/// **`@unique` on `ip` is the whole point.** An ISP's two operators can pick the
/// same address from two different free lists at the same moment, and no amount of
/// checking in application code closes that window — the check and the insert are
/// two statements. The index settles it: one transaction wins and the other is
/// refused, which is why `allocate()` catches the violation rather than
/// pre-checking.
///
/// `@unique` on `customerId` is the same idea from the other side: one address per
/// customer, so a change of pool frees the old one rather than leaving a customer
/// holding two.
model IpAllocation {
  id     String @id @default(cuid())
  ip     String @unique
  /// The same address, each octet zero-padded to three digits, so a *lexical* sort
  /// is a *numeric* one: "10.30.0.10" before "10.30.0.2", which is what plain
  /// string ordering gives and is not what "next free address" means to anybody
  /// reading a subnet. Without it, auto-assign hands out .10, .11 … .19 before
  /// ever reaching .2, and the pool fills in an order no operator would choose.
  sortKey String
  poolId String
  pool   IpPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  customerId String? @unique
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// Free | Reserved | Allocated
  ///
  /// Stored rather than derived from `customerId` so an address held for a gateway
  /// or a planned customer is not silently handed out, and so "allocated" means
  /// one thing in the database and the same thing in the UI.
  status String  @default("Free")
  note   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([poolId, status])
  @@index([status])
}

/// Failed sign-in attempts, so a lockout survives a restart and is shared
/// across every instance behind a load balancer.
model LoginAttempt {
  email   String   @id
  count   Int      @default(0)
  firstAt DateTime @default(now())
  ip      String?
}

/// A password reset in flight. The token is stored hashed: reading this table
/// must not hand out the ability to take over an account.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}
